[Unit]
Description=Zyablik Bot safe test service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/zyablik-bot
EnvironmentFile=-/root/zyablik-bot/.env
ExecStart=/root/.nvm/versions/node/v24.16.0/bin/node /root/zyablik-bot/src/bot-platform/app.js
Restart=always
RestartSec=5
# ADR-0045: fail loudly — не бесконечный цикл рестартов. Если сервис не
# стартует 5 раз подряд за 2 минуты, systemd останавливает попытки.
StartLimitIntervalSec=120
StartLimitBurst=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
